@model List<TareaModel>
@using Entities.Enums
@using System.Linq

@{
    ViewData["Title"] = "Tablero de Tareas del Proyecto";

    Dictionary<EstadoTarea, List<TareaModel>> tareasPorEstado = new Dictionary<EstadoTarea, List<TareaModel>>();

    foreach (EstadoTarea estado in Enum.GetValues(typeof(EstadoTarea)))
    {
        tareasPorEstado.Add(estado, new List<TareaModel>());
    }

    Guid currentProyectoId = Guid.Empty;

    if (Model != null)
    {
        foreach (var tarea in Model)
        {
            if (tareasPorEstado.ContainsKey(tarea.Estado))
            {
                tareasPorEstado[tarea.Estado].Add(tarea);
            }
        }
        if (ViewBag.ProyectoId != null)
        {
            currentProyectoId = (Guid)ViewBag.ProyectoId;
        }
    }

    var estadosSelectList = Html.GetEnumSelectList<EstadoTarea>();
}

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="CrearTarea" 
           asp-route-proyectoId="@currentProyectoId" 
           class="btn btn-success btn-lg shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-circle-fill me-2"></i> Crear Tarea
        </a>
        <h1 class="text-center text-primary display-4 flex-grow-1 mb-0">
            <i class="bi bi-columns-gap me-3"></i> @ViewData["Title"]
        </h1>
        <div style="width: 170px;"></div> 

    </div>

    <hr class="my-4"/>

    <div class="d-flex flex-nowrap overflow-auto pb-4">

        @foreach (var entry in tareasPorEstado)
        {
            var estado = entry.Key;
            var tareas = entry.Value;
            var estadoNombre = estado.ToString();
            var colHeaderClass = estado == EstadoTarea.Completada ? "text-success" : "text-secondary";

                <div class="p-3 flex-shrink-0" style="width: 400px;">
                    <div class="card h-100 shadow-lg border-0 bg-white">

                        <div class="card-header bg-light border-bottom p-4">
                            <h4 class="@colHeaderClass mb-0 fs-4 fw-bolder">
                            @estadoNombre
                                <span class="badge bg-secondary text-white ms-3 fs-6">@tareas.Count</span>
                            </h4>
                        </div>

                        <div class="card-body p-4">
                        @if (!tareas.Any())
                        {
                                    <div class="text-center text-muted p-5 border rounded fs-5">
                                        No hay tareas en este estado.
                                    </div>
                        }
                        else
                        {
                            @foreach (var tarea in tareas)
                            {
                                string prioridadBorderClass = "border-start-5 border-primary";

                                switch (tarea.Prioridad)
                                {
                                    case Prioridad.Alta:
                                        prioridadBorderClass = "border-start-5 border-danger";
                                        break;
                                    case Prioridad.Media:
                                        prioridadBorderClass = "border-start-5 border-warning";
                                        break;
                                    case Prioridad.Baja:
                                        prioridadBorderClass = "border-start-5 border-info";
                                        break;
                                }

                                            <div class="card task-card mb-4 shadow rounded @prioridadBorderClass">
                                                <div class="card-body p-4">

                                                    <h5 class="card-title text-truncate mb-2 fw-bold fs-5">@tarea.Titulo</h5>

                                                    <p class="card-text text-muted mb-3 fs-6">@tarea.Descripcion</p>

                                                    <span class="badge text-bg-info text-decoration-none me-3 py-2 px-3 fs-6">
                                                        <i class="bi bi-clock me-1"></i> @tarea.EstimacionDias días
                                                    </span>

                                        @if (tarea.Miembros != null && tarea.Miembros.Any())
                                        {
                                                            <div class="d-flex flex-wrap mt-3">
                                                                <span class="text-muted fs-6 me-3">Asignados:</span>
                                                @foreach (var miembro in tarea.Miembros)
                                                {
                                                                        <span class="badge text-bg-primary text-truncate me-2 mb-2 py-2 px-3 fs-6" style="max-width: 180px;">
                                                                             <i class="bi bi-person-fill me-1"></i> @miembro.UserName
                                                                        </span>
                                                }
                                                            </div>
                                        }
                                        else
                                        {
                                                            <span class="badge text-bg-secondary mt-3 fs-6 py-2 px-3">Sin Asignar</span>
                                        }

                                                    <hr class="my-3"/>

                                                    <button type="button" 
                                                            class="btn btn-sm btn-outline-secondary w-100" 
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#cambiarEstadoModal"
                                                            data-tarea-id="@tarea.TareaId"
                                                            data-tarea-titulo="@tarea.Titulo"
                                                            data-estado-actual="@tarea.Estado.ToString()">
                                                        <i class="bi bi-arrow-right-circle me-1"></i> Cambiar Estado
                                                    </button>

                                                </div>
                                            </div>
                            }
                        }
                        </div>
                    </div>
                </div>
        }

    </div>
</div>

<div class="modal fade" id="cambiarEstadoModal" tabindex="-1" aria-labelledby="cambiarEstadoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form id="cambiarEstadoForm" asp-action="CambiarEstado" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="cambiarEstadoModalLabel">Cambiar Estado de Tarea</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <input type="hidden" name="TareaId" id="modalTareaId" /> 
                    <input type="hidden" name="ProyectoId" value="@currentProyectoId" />

                    <p>
                        Está cambiando el estado de la tarea: <strong id="modalTareaTitulo"></strong>.
                        Estado actual: <span class="badge bg-secondary" id="modalEstadoActual"></span>
                    </p>

                    <div class="mb-3">
                        <label for="nuevoEstado" class="form-label fw-bold">Seleccione Nuevo Estado</label>
                        <select class="form-select form-select-lg" name="NuevoEstado" id="nuevoEstado">
                            @foreach (var item in estadosSelectList)
                            {
                                    <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Cambio</button>
                </div>
            </form>

        </div>
    </div>
</div>


@section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var cambiarEstadoModal = document.getElementById('cambiarEstadoModal');
                cambiarEstadoModal.addEventListener('show.bs.modal', function (event) {

                    var button = event.relatedTarget;

                    var tareaId = button.getAttribute('data-tarea-id');
                    var tareaTitulo = button.getAttribute('data-tarea-titulo');
                    var estadoActual = button.getAttribute('data-estado-actual');

                    var modalTitle = cambiarEstadoModal.querySelector('#modalTareaTitulo');
                    var modalEstado = cambiarEstadoModal.querySelector('#modalEstadoActual');
                    var modalId = cambiarEstadoModal.querySelector('#modalTareaId');
                    var modalDropdown = cambiarEstadoModal.querySelector('#nuevoEstado');

                    modalTitle.textContent = tareaTitulo;
                    modalEstado.textContent = estadoActual;
                    modalId.value = tareaId;

                    modalDropdown.value = estadoActual;
                });

                var form = document.getElementById('cambiarEstadoForm');
                form.addEventListener('submit', function (e) {
                    var proyectoId = document.querySelector('input[name="ProyectoId"]').value;
                    this.action += '?ProyectoId=' + proyectoId;
                });
            });
        </script>
}