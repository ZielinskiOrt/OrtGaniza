@model CrearTareaModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using Entities.Enums
@{
    ViewData["Title"] = "Crear Nueva Tarea";
    SelectList responsablesSelectList = new SelectList(
            Model.Usuarios ?? new List<UsuarioModel>(),
            "UserId",
            "UserName"
    );
    SelectList prioridadSelectList = new SelectList(Enum.GetValues(typeof(Prioridad)));
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-sm-12">

            <div class="card shadow-lg border-0 rounded-5">
                <div class="card-body p-4 p-md-5">

                    <h2 class="card-title text-center mb-4 pb-2 border-bottom text-primary">
                        <i class="bi bi-list-task me-2"></i> @ViewData["Title"]
                    </h2>

                    <form asp-action="CrearTarea" method="post" novalidate id="formulario-crear-tarea">

                        <input type="hidden" asp-for="ProyectoId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                        <div class="mb-4">
                            <label asp-for="Titulo" class="form-label fw-bold">Título de la Tarea</label>
                            <input asp-for="Titulo" class="form-control" id="txtTitulo" placeholder="Ej: Diseñar la sección de Precios" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>

                            <small id="error-titulo-requerido" class="text-danger fw-bold" style="display:none;">El título es requerido.</small>
                            <small id="error-titulo-largo" class="text-danger fw-bold" style="display:none;">Debe tener máximo 100 caracteres.</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" id="txtDescripcion" placeholder="Detalles, requisitos y contexto de la tarea."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>

                            <small id="error-descripcion-largo" class="text-danger fw-bold" style="display:none;">Debe tener máximo 1000 caracteres.</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ResponsablesIds" class="form-label fw-bold">Responsables</label>
                            <select multiple asp-for="ResponsablesIds" asp-items="responsablesSelectList" class="form-select form-control-lg" data-placeholder="Escribe el nombre o email de los responsables (ej: Juan Pérez, María L.)" id="selectResponsables"></select>
                            <span asp-validation-for="ResponsablesIds" class="text-danger small"></span>
                            <small id="error-responsables-requeridos" class="text-danger fw-bold" style="display:none;">Debes seleccionar al menos un responsable.</small>
                        </div>

                        <hr class="my-5">
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="FechaInicio" class="form-label fw-bold">Fecha de Inicio</label>
                                <input asp-for="FechaInicio" type="date" class="form-control" id="dtFechaInicio" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                                <small id="error-fecha-requerida" class="text-danger fw-bold" style="display:none;">La fecha de inicio es requerida.</small>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Prioridad" class="form-label fw-bold">Prioridad</label>
                                <select asp-for="Prioridad" asp-items="Html.GetEnumSelectList<Prioridad>()" class="form-select" id="selectPrioridad">
                                    <option value="" selected disabled>Define la prioridad...</option>
                                </select>
                                <span asp-validation-for="Prioridad" class="text-danger small"></span>
                                <small id="error-prioridad-requerida" class="text-danger fw-bold" style="display:none;">La prioridad es requerida.</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="EstimacionDias" class="form-label fw-bold">Tiempo Estimado (días)</label>
                                <input asp-for="EstimacionDias" type="number" step="1" class="form-control" id="txtTiempoEstimado" placeholder="Ej: 4" />
                                <span asp-validation-for="EstimacionDias" class="text-danger small"></span>
                                <small id="error-tiempo-requerido" class="text-danger fw-bold" style="display:none;">El tiempo estimado es requerido.</small>
                                <small id="error-tiempo-valido" class="text-danger fw-bold" style="display:none;">Debe ser un número válido (ej: 4 o 5).</small>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Estado Inicial</label>
                                <p class="form-control-static pt-2">Backlog</p>
                            </div>
                        </div>
                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill">
                                <i class="bi bi-list-task me-2"></i> Crear Tarea
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/crear-tarea.js"></script>
}