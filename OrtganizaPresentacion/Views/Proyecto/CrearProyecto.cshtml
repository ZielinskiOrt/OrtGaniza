@model ProyectoCrearModel
@{
    ViewData["Title"] = "Crear Nuevo Proyecto";

    SelectList usuariosSelectList = new SelectList(
         Model.UsuariosDisponibles,
         "Id",
         "UserName",
         Model.ProyectoModel.MiembrosIds
     );
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-sm-12">

            <div class="card shadow-lg border-0 rounded-5">
                <div class="card-body p-4 p-md-5">

                    <h2 class="card-title text-center mb-4 pb-2 border-bottom text-primary">
                        <i class="bi bi-folder-plus me-2"></i> @ViewData["Title"]
                    </h2>

                    <form asp-action="Crear" method="post" novalidate>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <h4 class="mb-3 text-secondary">Detalles</h4>

                        <div class="mb-4">
                            <label asp-for="ProyectoModel.Nombre" class="form-label fw-bold">Nombre del Proyecto</label>
                            <input asp-for="ProyectoModel.Nombre" class="form-control form-control-lg" placeholder="EJ: Rediseño Web Principal" />
                            <span asp-validation-for="ProyectoModel.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ProyectoModel.Descripcion" class="form-label fw-bold">Descripción</label>
                            <textarea asp-for="ProyectoModel.Descripcion" class="form-control" rows="4" placeholder="Breve resumen de los objetivos del proyecto."></textarea>
                            <span asp-validation-for="ProyectoModel.Descripcion" class="text-danger small"></span>
                        </div>

                        <hr class="my-5">

                        <h4 class="mb-3 text-secondary">Equipo</h4>

                        <div class="mb-4 p-3 bg-light rounded-3 border">
                            <label class="form-label fw-bold d-block">Propietario del Proyecto</label>
                            <p class="mb-0 text-dark">
                                <i class="bi bi-person-fill me-1"></i>
                                @Model.ProyectoModel.PropietarioNombre (Tú)
                            </p>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ProyectoModel.MiembrosIds" class="form-label fw-bold">Miembros del Equipo</label>

                            <select **multiple** asp-for="ProyectoModel.MiembrosIds" asp-items="usuariosSelectList" class="form-select form-control-lg" data-placeholder="Selecciona uno o más miembros..."></select>

                            <span asp-validation-for="ProyectoModel.MiembrosIds" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill">
                                <i class="bi bi-check-circle-fill me-2"></i> Crear Proyecto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/validaciones-crear.js"></script>
}