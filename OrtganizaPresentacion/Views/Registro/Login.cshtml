@model LoginModel
@* El modelo que uses en tu proyecto, por ejemplo: @model UsuarioLoginModel *@

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="card-title text-center mb-4 text-primary fs-3 fw-bold">
                        <i class="bi bi-person-circle me-2"></i> LOGIN
                    </h2>

                    <form asp-action="Login" method="post" novalidate>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="UserId" class="form-label fw-bold">Usuario o Email</label>
                            <input asp-for="UserId" class="form-control form-control-lg" placeholder="Ingrese su usuario o email" />
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Contrasena" class="form-label fw-bold">Contraseña</label>
                            <input asp-for="Contrasena" type="password" class="form-control form-control-lg" placeholder="••••••••" />
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
}