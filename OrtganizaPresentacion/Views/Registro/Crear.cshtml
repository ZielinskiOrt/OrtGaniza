@model CrearUsuarioModel
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-10">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h2 class="card-title text-center mb-4">@ViewData["Title"]</h2>

                    <form asp-action="Crear" method="post" novalidate id="form-registro">

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" id="txtEmail" />
                            <span asp-validation-for="Email" class="text-danger small"></span>

                            <small id="error-email-requerido" class="text-danger fw-bold" style="display:none;">El correo es requerido.</small>
                            <small id="error-email-formato" class="text-danger fw-bold" style="display:none;">No es un formato de correo válido.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmEmail" class="form-label"></label>
                            <input asp-for="ConfirmEmail" class="form-control" id="txtConfirmEmail" />
                            <span asp-validation-for="ConfirmEmail" class="text-danger small"></span>

                            <small id="error-confirmar-email-requerido" class="text-danger fw-bold" style="display:none;">Debes confirmar tu correo.</small>
                            <small id="error-confirmar-email-coincidencia" class="text-danger fw-bold" style="display:none;">Los correos no coinciden.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" id="txtUsuario" />
                            <span asp-validation-for="Username" class="text-danger small"></span>

                            <small id="error-usuario-requerido" class="text-danger fw-bold" style="display:none;">El nombre de usuario es requerido.</small>
                            <small id="error-usuario-largo" class="text-danger fw-bold" style="display:none;">Debe tener al menos 8 caracteres.</small>
                            <small id="error-usuario-seguridad" class="text-danger fw-bold" style="display:none;">Falta: mayúscula, minúscula o carácter especial.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" id="txtNombre" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>

                            <small id="error-nombre-requerido" class="text-danger fw-bold" style="display:none;">El nombre es requerido.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Apellido" class="form-label"></label>
                            <input asp-for="Apellido" class="form-control" id="txtApellido" />
                            <span asp-validation-for="Apellido" class="text-danger small"></span>

                            <small id="error-apellido-requerido" class="text-danger fw-bold" style="display:none;">El apellido es requerido.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" type="password" id="txtPassword" />
                            <span asp-validation-for="Password" class="text-danger small"></span>

                            <small id="error-password-requerido" class="text-danger fw-bold" style="display:none;">La contraseña es requerida.</small>
                            <small id="error-password-largo" class="text-danger fw-bold" style="display:none;">Mínimo 8 caracteres.</small>
                            <small id="error-password-seguridad" class="text-danger fw-bold" style="display:none;">Falta: Mayúscula, minúscula y carácter especial.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" id="txtConfirmPassword" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>

                            <small id="error-confirmar-password-requerido" class="text-danger fw-bold" style="display:none;">Debes confirmar tu contraseña.</small>
                            <small id="error-confirmar-password-coincidencia" class="text-danger fw-bold" style="display:none;">Las contraseñas no coinciden.</small>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg" id="btnRegistrar">Registrarme</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/validaciones-crear.js"></script>
}